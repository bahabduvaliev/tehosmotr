---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tickets from '../components/Tickets.astro';
import { t } from '../i18n';
const d = t('ru');
---
<Base lang="ru" title={d.notFound.title} noindex>
  <PageHero lang="ru" h1a={d.notFound.h1a} h1b={d.notFound.h1b} sub={d.notFound.sub} />
  <Tickets lang="ru" heading={false} />
</Base>
